# ============================================================================
# Biến môi trường cho API (apps/api) và máy chủ bảng viết (services/whiteboard-sync)
# Cách dùng:  cp .env.example .env   rồi điền giá trị thật.
# KHÔNG commit file .env. Khóa "service role" chỉ được nằm ở máy chủ, không đưa lên web.
# Biến của giao diện web nằm riêng ở apps/web/.env.example (tiền tố VITE_).
# ============================================================================

# --- Chung -------------------------------------------------------------------
APP_ENV=development                 # development | production
APP_NAME=GiaSuOnline                # tên hiển thị, đổi theo thương hiệu của bạn
LOG_LEVEL=INFO

# --- API (FastAPI) -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Khóa service role: BỎ QUA RLS, chỉ dùng ở máy chủ, tuyệt đối không đưa vào web
SUPABASE_SERVICE_ROLE_KEY=
# Chỉ cần với dự án Supabase cũ ký token bằng HS256 (Project Settings > API > JWT Secret).
# Dự án mới ký ES256: để trống, API tự lấy khóa công khai từ SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- LiveKit (video, micro) --------------------------------------------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# --- Bảng viết (Excalidraw + máy chủ đồng bộ) --------------------------------
# API ký token cho bảng viết, máy chủ đồng bộ dùng cùng khóa này để kiểm tra. Tạo bằng: openssl rand -hex 32
WHITEBOARD_JWT_SECRET=
WHITEBOARD_TOKEN_TTL_SECONDS=7200
WHITEBOARD_SYNC_PORT=8787
# Địa chỉ WebSocket mà trình duyệt kết nối tới (dùng wss:// khi chạy thật)
WHITEBOARD_PUBLIC_URL=ws://localhost:8787
# Địa chỉ API gọi máy chủ bảng viết để đóng phòng khi kết thúc buổi (Docker: http://whiteboard-sync:8787)
WHITEBOARD_INTERNAL_URL=http://localhost:8787
# Thư mục máy chủ bảng lưu nội dung bảng đang dạy (mặc định: data/boards ở thư mục gốc, đã có trong .gitignore)
WHITEBOARD_DATA_DIR=
# Ghi xuống đĩa sau bao nhiêu mili giây kể từ nét vẽ cuối
WHITEBOARD_SAVE_DELAY_MS=2000

# Chu kỳ (giây) API chuyển buổi học quá giờ mà giáo viên chưa vào sang no_show; 0 để tắt
NO_SHOW_INTERVAL_SECONDS=300

# --- Quyền riêng tư & lưu giữ dữ liệu ----------------------------------------
# Không ghi hình mặc định (giữ false nếu chưa có sự đồng ý của phụ huynh)
RECORDING_ENABLED=false
# Số ngày giữ ảnh bài làm trước khi nhắc xóa/lưu trữ
SUBMISSION_RETENTION_DAYS=365

# --- AI (Giai đoạn 3, chưa dùng ở Giai đoạn 1) -------------------------------
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
# Trần chi phí để không vượt ngân sách
AI_MONTHLY_BUDGET_USD=10
AI_MAX_IMAGES_PER_DAY=30
# Bot OpenAI + RAG (chỉ API). Chọn model hỗ trợ Responses/function calling.
# Bật sau khi áp migration 0010 và chốt ngân sách/dữ liệu. Không dán key vào chat.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ASSISTANT_DAILY_USER_TURNS=20
ASSISTANT_DAILY_TOTAL_TURNS=100
ASSISTANT_MAX_OUTPUT_TOKENS=1000
ASSISTANT_STUDENT_LESSONS_ENABLED=false
# OCR ảnh bài làm bằng Gemini (chỉ API). Giáo viên bấm "Đọc bài bằng AI"; chỉ chạy khi đã ghi nhận
# phụ huynh đồng ý. Mỗi lần đọc tính một lượt trợ lý AI của giáo viên (cùng hạn mức ngày).
OCR_ENABLED=false
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.7-flash
# Giới hạn ảnh nộp: số ảnh mỗi bài, dung lượng mỗi ảnh (byte)
SUBMISSION_MAX_FILES=6
SUBMISSION_MAX_BYTES=8388608
