# ============================================================================
# Biến môi trường cho API (apps/api) và máy chủ bảng viết (services/whiteboard-sync)
# Cách dùng:  cp .env.example .env   rồi điền giá trị thật.
# KHÔNG commit file .env. Khóa "service role" chỉ được nằm ở máy chủ, không đưa lên web.
# Biến của giao diện web nằm riêng ở apps/web/.env.example (tiền tố VITE_).
# ============================================================================

# --- Chung -------------------------------------------------------------------
APP_ENV=development                 # development | production
APP_NAME=GiaSuOnline                # tên hiển thị, đổi theo thương hiệu của bạn
LOG_LEVEL=INFO

# --- API (FastAPI) -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Khóa service role: BỎ QUA RLS, chỉ dùng ở máy chủ, tuyệt đối không đưa vào web
SUPABASE_SERVICE_ROLE_KEY=
# Chuỗi bí mật JWT của Supabase (Project Settings > API > JWT Secret) để API xác thực token người dùng
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- LiveKit (video, micro) --------------------------------------------------
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# --- Bảng viết (Excalidraw + máy chủ đồng bộ) --------------------------------
# API ký token cho bảng viết, máy chủ đồng bộ dùng cùng khóa này để kiểm tra. Tạo bằng: openssl rand -hex 32
WHITEBOARD_JWT_SECRET=
WHITEBOARD_TOKEN_TTL_SECONDS=7200
WHITEBOARD_SYNC_PORT=8787
# Địa chỉ WebSocket mà trình duyệt kết nối tới (dùng wss:// khi chạy thật)
WHITEBOARD_PUBLIC_URL=ws://localhost:8787

# --- Quyền riêng tư & lưu giữ dữ liệu ----------------------------------------
# Không ghi hình mặc định (giữ false nếu chưa có sự đồng ý của phụ huynh)
RECORDING_ENABLED=false
# Số ngày giữ ảnh bài làm trước khi nhắc xóa/lưu trữ
SUBMISSION_RETENTION_DAYS=365

# --- AI (Giai đoạn 3, chưa dùng ở Giai đoạn 1) -------------------------------
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
# Trần chi phí để không vượt ngân sách
AI_MONTHLY_BUDGET_USD=10
AI_MAX_IMAGES_PER_DAY=30
