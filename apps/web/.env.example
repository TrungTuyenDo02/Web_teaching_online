# Biến của giao diện web. Vite chỉ đưa biến có tiền tố VITE_ ra trình duyệt,
# nên ở đây KHÔNG được để khóa bí mật (service role, LiveKit secret, ...).
# Cách dùng:  cp .env.example .env.local

VITE_APP_NAME=GiaSuOnline
# Dùng 127.0.0.1 thay vì localhost: trên Windows, localhost có thể trỏ vào IPv6 (::1), nơi Docker/WSL
# hay chiếm cổng 8000, làm web không gọi được API (uvicorn chỉ nghe 127.0.0.1)
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Khóa anon/publishable: an toàn để public, quyền hạn do RLS quyết định
VITE_SUPABASE_ANON_KEY=
